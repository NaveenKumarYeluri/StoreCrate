<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StoreCrate.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="StoreCrate.App.Views.InstalledView"
             x:DataType="vm:InstalledViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,36" Spacing="14">

      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="Installed" Classes="h1" />
          <TextBlock Text="Apps and packages registered for your Windows account." Classes="muted" FontSize="13" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="secondary"
                Content="Check for updates"
                Command="{Binding CheckForUpdatesCommand}"
                VerticalAlignment="Center"
                ToolTip.Tip="Compare installed apps with the Microsoft Store catalog" />
        <Button Grid.Column="2"
                Classes="ghost"
                Content="Refresh"
                Command="{Binding RefreshCommand}"
                VerticalAlignment="Center"
                Margin="8,0,0,0" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
        <TextBox Text="{Binding Filter}"
                 Watermark="Filter by name, publisher or package family…"
                 MaxWidth="460"
                 HorizontalAlignment="Left"
                 MinWidth="320" />
        <ToggleSwitch Grid.Column="1"
                      Content="Show non-Store apps"
                      Margin="18,0,0,0"
                      IsChecked="{Binding IncludeNonStore}"
                      VerticalAlignment="Center"
                      ToolTip.Tip="Also list packages installed outside the Microsoft Store (system components, enterprise or sideloaded apps)." />
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{Binding StatusText}"
                   Classes="caption"
                   IsVisible="{Binding StatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
        <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      </StackPanel>

      <Border Classes="card" IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
        <StackPanel Spacing="6">
          <TextBlock Text="Could not read installed apps" Classes="h3" />
          <TextBlock Text="{Binding ErrorMessage}" Classes="error" FontSize="12.5" />
        </StackPanel>
      </Border>

      <Border Classes="soft" IsVisible="{Binding PendingUninstall, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding PendingUninstall.DisplayName, StringFormat='Uninstall {0}?'}" Classes="h3" />
            <TextBlock Text="The app and its local data will be removed for this Windows user."
                       Classes="caption" />
          </StackPanel>
          <Button Grid.Column="1" Classes="danger" Content="Uninstall" Margin="10,0,0,0" Command="{Binding ConfirmUninstallCommand}" />
          <Button Grid.Column="2" Classes="secondary" Content="Cancel" Margin="10,0,0,0" Command="{Binding CancelUninstallCommand}" />
        </Grid>
      </Border>

      <Border Classes="card" IsVisible="{Binding ShowEmptyState}">
        <StackPanel Spacing="6" Margin="4">
          <TextBlock Text="No apps to show" Classes="h3" />
          <TextBlock Text="Install something from Discover or Search, or enable the non-Store filter above."
                     Classes="muted"
                     FontSize="12.5" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Apps}" IsVisible="{Binding HasApps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:InstalledAppRow">
            <Border Classes="card" Padding="14" Margin="0,0,0,8">
              <Grid ColumnDefinitions="44,*,Auto">
                <Border Classes="logo" Width="44" Height="44" CornerRadius="12" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Initial}"
                             FontSize="17"
                             FontWeight="Bold"
                             Foreground="{DynamicResource AccentBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="14,0,0,0">
                  <TextBlock Text="{Binding DisplayName}"
                             FontWeight="SemiBold"
                             FontSize="14"
                             MaxLines="1"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding PublisherText}"
                             Classes="caption"
                             MaxLines="1"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding PackageFamilyName}"
                             FontSize="10.5"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             MaxLines="1"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0,0,0">
                  <StackPanel Orientation="Horizontal"
                              Spacing="8"
                              VerticalAlignment="Center"
                              IsVisible="{Binding HasUpdate}">
                    <TextBlock Text="{Binding UpdateVersionText}"
                               Classes="caption"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Classes="primary"
                            Content="Update"
                            Padding="12,6"
                            MinHeight="32"
                            Command="{Binding UpdateCommand}" />
                  </StackPanel>
                  <TextBlock Text="{Binding VersionText}"
                             Classes="caption"
                             VerticalAlignment="Center"
                             Margin="0,0,4,0"
                             IsVisible="{Binding !HasUpdate}" />
                  <Button Classes="secondary"
                          Content="Open"
                          Padding="12,6"
                          MinHeight="32"
                          Command="{Binding OpenCommand}" />
                  <Button Classes="ghost"
                          Content="Store page"
                          Padding="12,6"
                          MinHeight="32"
                          Command="{Binding ShowInStoreCommand}" />
                  <Button Classes="danger"
                          Content="Uninstall"
                          Padding="12,6"
                          MinHeight="32"
                          Command="{Binding UninstallCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>
